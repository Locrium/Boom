{
  "manifest_version": 3,
  "name": "Boom — Focus Budget",
  "version": "0.1.0",
  "description": "Give distracting sites one shared time budget, then lock them for a while.",
  "permissions": ["storage", "tabs", "alarms", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Boom", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["heartbeat.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["locked.html"], "matches": ["<all_urls>"] }
  ]
}
